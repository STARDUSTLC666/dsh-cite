{
  "name": "dsh-cite",
  "version": "0.13.0",
  "description": "DeepSeek Harness 学术引文工作台与 6 个 AI 智能体工具：默认「文献引力星图」可拖拽/滚轮缩放画布与悬浮 Zettelkasten 索引卡（1 键切经典列表排序视图），支持离线 DOI/BibTeX 拖放去重预览、Crossref 核查补全与 1 键差异采用、全字段原子编辑、GB/T 7714 / APA / IEEE / MLA / Chicago 5 格式 14 类文献导出与 1 键复制，内置 13 套明亮风格 × 8 套字体。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs",
    "CHANGELOG.md",
    "assets/plugin-icon.webp"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs && node scripts/build-updates.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "citation",
    "crossref",
    "gb-t-7714",
    "apa",
    "ieee",
    "mla",
    "chicago",
    "dsh-plugin",
    "deepseek",
    "ai-agent",
    "bibtex",
    "doi",
    "bibliography",
    "reference-manager",
    "zettelkasten",
    "academic",
    "research-tools",
    "文献",
    "引文"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-cite.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-cite/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-cite#readme",
  "author": "stardustlc",
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-bibtex": "0.9.0",
    "proper-lockfile": "4.1.2",
    "@stardustlc/dsh-updates": "0.2.10"
  },
  "icon": "./assets/plugin-icon.webp"
}
