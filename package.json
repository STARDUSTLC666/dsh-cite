{
  "name": "dsh-cite",
  "version": "0.4.1",
  "description": "批量导入 DOI / BibTeX，预览去重、补全文献元数据并导出引文。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test \"test/*.test.mjs\"",
    "prepublishOnly": "pnpm run build"
  },
  "dsh": {
    "client": { "inject": ["@deepseek-ai/dsh-client-ui-settings"], "platform": "web" },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "citation",
    "crossref",
    "gb-t-7714",
    "apa",
    "mla",
    "chicago",
    "dsh-plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-cite.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-cite/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-cite#readme",
  "author": "stardustlc",
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-bibtex": "0.9.0",
    "proper-lockfile": "4.1.2"
  }
}
